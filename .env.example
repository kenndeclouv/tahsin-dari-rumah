APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_OWNER=""

# ─── SEO ──────────────────────────────────────────────────────────────────────
SEO_SITE_NAME="Ust ICAS - Tahsin Privat"
SEO_TAGLINE="Sistem Administrasi Pembelajaran Tahsin Privat"
