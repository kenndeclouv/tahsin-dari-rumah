SEO_KEYWORDS="tahsin privat, manajemen tahsin, ngaji privat, sistem administrasi pengajar, ust icas"
SEO_AUTHOR="kenndeclouv"
SEO_LOCALE="id_ID"
SEO_URL="http://localhost:8000"
SEO_OG_TYPE="website"
SEO_OG_IMAGE="/assets/images/og-image.png"
SEO_TWITTER_HANDLE=""
SEO_ROBOTS_PUBLIC="index, follow"
SEO_ROBOTS_ADMIN="noindex, follow"
SEO_ROBOTS_AUTH="noindex, nofollow"
SEO_JSONLD_ENABLED=true
SEO_JSONLD_TYPE="EducationalOrganization"
SEO_JSONLD_NAME="Ust ICAS - Tahsin Privat"
SEO_JSONLD_DESC="Lembaga pembelajaran Tahsin offline privat yang berfokus pada kualitas bacaan, makhraj, dan tajwid."
